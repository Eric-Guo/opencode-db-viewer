<div class="sidebar sidebar-dark sidebar-fixed border-end <%= current_user&.sidebar_narrow? ? "sidebar-narrow-unfoldable" : "" -%>" id="sidebar" data-controller="sidebar">
  <div class="sidebar-header border-bottom">
    <div class="sidebar-brand">
      <%= link_to root_path, class: "text-reset text-decoration-none" do %>
        <span class="sidebar-brand-full"><strong class="d-block fs-5">OpenCode</strong><small class="oc-brand-caption">DB VIEWER</small></span>
      <% end %>
      <%= link_to root_path, class: "text-reset text-decoration-none" do %>
        <span class="sidebar-brand-narrow fw-bold" aria-label="OpenCode">OC</span>
      <% end %>
    </div>
    <button class="sidebar-toggler d-none d-lg-block" type="button" data-action="sidebar#toggle" aria-label="<%= t("layouts.header.toggle_narrow_sidebar") %>"></button>
    <button class="btn-close d-lg-none" type="button" data-coreui-close="sidebar" data-coreui-theme="dark" aria-label="<%= t("layouts.header.close_navigation") %>"></button>
  </div>
  <ul class="sidebar-nav" data-coreui="navigation" data-simplebar>
    <%= nav_item(t('.dashboard'), root_path, 'free.svg#cil-speedometer') do %>
      <span class="badge bg-primary ms-auto">NEW</span>
    <% end %>
    <%= nav_item(t('.projects'), projects_path, 'free.svg#cil-folder') %>

    <li class="nav-title"><%= t('user.account') -%></li>
    <li class="nav-group <%= controller_name == 'profiles' ? 'show' : '' -%>" data-controller="expender"
      data-expender-url-value="<%= account_ui_nav_group_items_path -%>"
      data-expender-loaded-value="<%= controller_name == 'profiles' -%>">
      <a class="nav-link nav-group-toggle" data-action="expender#click" href="#">
        <%= svg_icon('free.svg#cil-puzzle', 'nav-icon') %>
        <%= t('user.account') -%>
      </a>
      <ul class="nav-group-items" data-expender-target='htc'>
        <% if controller_name == 'profiles' %>
          <%= render partial: 'ui/nav_group_items/account', locals: {} %>
        <% end %>
      </ul>
    </li>
  </ul>
</div>
