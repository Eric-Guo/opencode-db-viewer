<div class="oc-page-intro"><h1 class="fs-4"><%= t("workspace.jobs") %></h1><p class="text-body-secondary"><%= t("workspace.recorded_work") %></p></div>
<%= form_with url: background_jobs_path, method: :get, local: true, class: "oc-work-filters" do |form| %>
  <%= form.search_field :q, value: @query, placeholder: t("workspace.search"), class: "form-control", aria: {label: t("workspace.search")} %>
  <%= form.select :status, [[t("workspace.all_statuses"), ""]] + %w[running completed error cancelled].map { |status| [t("workspace.statuses.#{status}"), status] }, {selected: @status}, class: "form-select", aria: {label: t("workspace.status")} %>
  <%= form.select :kind, [[t("workspace.all_kinds"), ""]] + %w[shell subagent image].map { |kind| [t("workspace.kinds.#{kind}"), kind] }, {selected: @kind}, class: "form-select", aria: {label: t("workspace.kind")} %>
  <%= form.submit t("viewer.filter"), class: "btn btn-outline-secondary" %>
  <%= link_to t("viewer.clear_filters"), background_jobs_path, class: "btn btn-link" %>
<% end %>
<div class="oc-work-list"><%= render partial: "background_jobs/job", collection: @jobs %></div>
<% if @jobs.empty? %><p class="text-body-secondary py-4"><%= t("workspace.no_jobs") %></p><% end %>
<% if @pagy.pages > 1 %><%== pagy_bootstrap_nav(@pagy) %><% end %>
