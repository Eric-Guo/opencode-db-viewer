<div class="card bg-body-tertiary border-0 mt-2">
  <div class="card-body p-3">
    <% if state.key?("input") %>
      <section class="mb-3">
        <div class="small fw-semibold text-uppercase text-body-secondary mb-1"><%= t("sessions.show.tool_input") %></div>
        <pre class="bg-body border rounded p-3 mb-0 small" style="max-height: 40rem; overflow: auto;"><code><%= formatted_debug_value(state["input"]) %></code></pre>
      </section>
    <% end %>

    <% if state.key?("output") %>
      <section class="mb-3">
        <div class="small fw-semibold text-uppercase text-body-secondary mb-1"><%= t("sessions.show.tool_output") %></div>
        <pre class="bg-body border rounded p-3 mb-0 small" style="max-height: 40rem; overflow: auto;"><code><%= formatted_debug_value(state["output"]) %></code></pre>
      </section>
    <% end %>

    <% if state.key?("result") %>
      <section class="mb-3">
        <div class="small fw-semibold text-uppercase text-body-secondary mb-1"><%= t("sessions.show.tool_result") %></div>
        <pre class="bg-body border rounded p-3 mb-0 small" style="max-height: 40rem; overflow: auto;"><code><%= formatted_debug_value(state["result"]) %></code></pre>
      </section>
    <% end %>

    <% if state.key?("structured") %>
      <section class="mb-3">
        <div class="small fw-semibold text-uppercase text-body-secondary mb-1"><%= t("sessions.show.tool_structured") %></div>
        <pre class="bg-body border rounded p-3 mb-0 small" style="max-height: 40rem; overflow: auto;"><code><%= formatted_debug_value(state["structured"]) %></code></pre>
      </section>
    <% end %>

    <% if state["content"].is_a?(Array) %>
      <section class="mb-3">
        <div class="small fw-semibold text-uppercase text-body-secondary mb-1"><%= t("sessions.show.tool_content") %></div>
        <% state["content"].each_with_index do |item, index| %>
          <div class="small text-body-secondary mb-1"><%= item.is_a?(Hash) ? item["type"].presence || "item" : "item" %> #<%= index + 1 %></div>
          <% if item.is_a?(Hash) && item["type"] == "file" && local_assigns[:message] %>
            <%= render "sessions/attachment", file: item, message: message, selector: {content: content_index, item: index} %>
          <% else %>
            <% value = item.is_a?(Hash) && item["type"] == "text" ? item["text"] : item %>
            <pre class="oc-pre"><code><%= formatted_debug_value(value) %></code></pre>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <% attachments = local_assigns[:part] ? part.tool_attachments : [] %>
    <% if attachments.any? %>
      <section class="mb-3">
        <div class="small fw-semibold text-uppercase text-body-secondary mb-1"><%= t("sessions.show.tool_attachments") %></div>
        <% attachments.each_with_index do |attachment, index| %>
          <div class="mb-1">
            <span class="badge bg-body text-body border"><%= part.attachment_filename(attachment) %> · <%= attachment["mime"] %></span>
            <% if attachment["url"].to_s.start_with?("data:") %>
              <%= link_to t("sessions.show.download"), project_session_part_path(@project, @session, part, attachment: index), class: "small" %>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <% if state["error"].present? %>
      <section class="mb-3">
        <div class="small fw-semibold text-uppercase text-danger mb-1"><%= t("sessions.show.tool_error") %></div>
        <pre class="bg-body border border-danger rounded p-3 mb-0 small" style="max-height: 40rem; overflow: auto;"><code><%= formatted_debug_value(state["error"]) %></code></pre>
      </section>
    <% end %>

    <% debug_metadata = {
      metadata: state["metadata"],
      title: state["title"],
      time: tool["time"] || state["time"],
      executed: tool["executed"],
      providerState: tool["providerState"],
      providerResultState: tool["providerResultState"]
    }.compact %>
    <% if debug_metadata.any? %>
      <section>
        <div class="small fw-semibold text-uppercase text-body-secondary mb-1"><%= t("sessions.show.tool_debug_metadata") %></div>
        <pre class="bg-body border rounded p-3 mb-0 small" style="max-height: 40rem; overflow: auto;"><code><%= pretty_json(debug_metadata) %></code></pre>
      </section>
    <% end %>
  </div>
</div>
