<% if message.user? %>
  <div class="d-flex justify-content-end mb-3">
    <div class="oc-user-bubble" style="max-width: 80%;">
      <div class="text-break" style="white-space: pre-wrap;"><%= message.text_content %></div>
      <% message.files.each_with_index do |file, index| %><%= render "sessions/attachment", file: file, message: message, selector: {file: index} %><% end %>
      <div class="text-end mt-1" style="font-size: .72rem; opacity: .6;">#<%= message.seq %> · <%= opencode_time(message.time_created_at) %> · <code style="color: inherit;"><%= message.id %></code></div>
    </div>
  </div>
<% elsif %w[synthetic system skill].include?(message.message_type) %>
  <div class="d-flex justify-content-end mb-3">
    <div class="p-2 px-3 rounded border bg-body-tertiary" style="max-width: 80%;">
      <span class="badge bg-secondary mb-1"><%= message.message_type %></span>
      <div class="text-break" style="white-space: pre-wrap;"><%= message.text_content %></div>
      <% message.files.each_with_index do |file, index| %><%= render "sessions/attachment", file: file, message: message, selector: {file: index} %><% end %>
      <div class="text-end text-body-secondary mt-1" style="font-size: .72rem;">#<%= message.seq %> · <%= opencode_time(message.time_created_at) %> · <code><%= message.id %></code></div>
    </div>
  </div>
<% elsif message.assistant? %>
  <div class="d-flex justify-content-start mb-3">
    <div class="oc-assistant">
      <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
        <span class="text-body-secondary small"><%= message.message_type %></span>
        <% if message.agent.present? %><span class="badge bg-body-tertiary text-body border"><%= message.agent %></span><% end %>
        <% if message.model_id.present? %><span class="small text-body-secondary"><%= [message.provider_id, message.model_id].compact.join("/") %></span><% end %>
        <% if message.finish_reason.present? %><span class="badge bg-dark"><%= message.finish_reason %></span><% end %>
      </div>

      <% message.content.each_with_index do |content, content_index| %>
        <% case content["type"]; when "text" %>
          <div class="oc-markdown mb-3" data-controller="markdown"><%= content["text"] %></div>
          <details class="oc-source"><summary><%= t("workspace.source") %></summary><pre class="oc-pre"><%= content["text"] %></pre></details>
        <% when "reasoning" %>
          <details class="mb-3"><summary class="text-body-secondary"><%= t("sessions.show.thinking") %> (<%= content["text"].to_s.length %> <%= t("sessions.show.chars") %>)</summary><div class="bg-body-tertiary rounded p-3 mt-2 text-break small" style="white-space: pre-wrap;"><%= content["text"] %></div></details>
        <% when "file" %>
          <%= render "sessions/attachment", file: content, message: message, selector: {content: content_index} %>
        <% when "tool" %>
          <%= render "sessions/tool_call", tool: message.tools.fetch(content_index), message: message, content_index: content_index %>
        <% else %>
          <pre class="bg-body-tertiary rounded p-3 small"><code><%= pretty_json(content) %></code></pre>
        <% end %>
      <% end %>
      <% if message.tokens.present? || message.cost.present? %><div class="small text-body-secondary"><%= t("sessions.show.cost") %>: <%= number_to_currency(message.cost.to_f, precision: 8) %> · <%= t("sessions.show.tokens") %>: <%= pretty_json(message.tokens).squish %></div><% end %>
      <div class="text-end text-body-secondary mt-1" style="font-size: .72rem;">#<%= message.seq %> · <%= opencode_time(message.time_created_at) %> · <code><%= message.id %></code></div>
    </div>
  </div>
<% elsif %w[agent-switched model-switched].include?(message.message_type) %>
  <div class="text-center mb-3">
    <span class="badge rounded-pill bg-body-tertiary text-body-secondary border fw-normal"><%= message.message_type == "agent-switched" ? t("sessions.show.agent_switched", agent: message.parsed_data["agent"]) : t("sessions.show.model_switched", model: [message.provider_id, message.model_id].compact.join("/")) %></span>
  </div>
<% else %>
  <div class="text-center mb-3">
    <details class="d-inline-block text-start" style="max-width: 90%;">
      <summary class="text-body-secondary small"><span class="badge bg-secondary"><%= message.message_type %></span> <span style="opacity: .75;">#<%= message.seq %> · <%= opencode_time(message.time_created_at) %></span></summary>
      <div class="mt-2">
        <% case message.message_type; when "shell" %>
          <div><span class="badge bg-dark"><%= message.parsed_data["status"] %></span> <code><%= message.parsed_data["command"] %></code></div><% if message.parsed_data["output"].present? %><pre class="bg-dark text-white rounded p-3 mt-2 small"><code><%= message.parsed_data["output"].to_s.truncate(30_000) %></code></pre><% end %>
        <% when "compaction" %>
          <div><span class="small text-body-secondary"><%= message.parsed_data["status"] %></span> <%= message.parsed_data["reason"] %></div><% if message.parsed_data["summary"].present? %><div class="mt-2 text-break" style="white-space: pre-wrap;"><%= message.parsed_data["summary"] %></div><% end %>
        <% else %>
          <pre class="bg-body-tertiary rounded p-3 small"><code><%= pretty_json(message.parsed_data).truncate(30_000) %></code></pre>
        <% end %>
        <div class="text-body-secondary mt-1" style="font-size: .72rem;"><code><%= message.id %></code></div>
      </div>
    </details>
  </div>
<% end %>
