<div class="card mb-4">
  <div class="card-header bg-primary text-white d-flex align-items-center">
    <%= svg_icon("free.svg#cil-chat-bubble", "icon me-2") %>
    <strong><%= @session.title.presence || @session.slug %></strong>
    <%= button_to project_session_path(@project, @session), method: :delete, class: "btn btn-danger btn-sm", form: {class: "ms-auto"}, onclick: "return confirm(this.dataset.confirm)", data: {confirm: t(".remove_confirm")} do %>
      <%= svg_icon("free.svg#cil-trash", "icon me-1") %><%= t(".remove_session") %>
    <% end %>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-lg-8"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".session_id") %></div><code class="text-break"><%= @session.id %></code></div>
      <div class="col-lg-4"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".version") %></div><%= @session.version %></div>
      <div class="col-lg-8"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".directory") %></div><code class="text-break"><%= @session.directory %></code><% if @session.path.present? %><div class="small text-medium-emphasis"><%= t(".path") %>: <code><%= @session.path %></code></div><% end %></div>
      <div class="col-md-4"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".agent_model") %></div><%= @session.agent.presence || "-" %><div class="small text-medium-emphasis"><%= [@session.model_data["providerID"], @session.model_data["id"], @session.model_data["variant"]].compact.join("/").presence || "-" %></div></div>
      <div class="col-md-3"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".cost") %></div><%= number_to_currency(@session.cost.to_f, precision: 8) %></div>
      <div class="col-md-3"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".tokens_input") %></div><%= number_with_delimiter(@session.tokens_input) %></div>
      <div class="col-md-3"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".tokens_output") %></div><%= number_with_delimiter(@session.tokens_output) %></div>
      <div class="col-md-3"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".tokens_other") %></div><%= number_with_delimiter(@session.tokens_reasoning.to_i + @session.tokens_cache_read.to_i + @session.tokens_cache_write.to_i) %></div>
      <div class="col-md-3"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".files_changed") %></div><%= @session.summary_files || 0 %></div>
      <div class="col-md-3"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".additions") %></div><span class="text-success">+<%= @session.summary_additions || 0 %></span></div>
      <div class="col-md-3"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".deletions") %></div><span class="text-danger">-<%= @session.summary_deletions || 0 %></span></div>
      <div class="col-md-3"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".state") %></div><% if @session.time_archived_at %><span class="badge bg-secondary"><%= t(".archived") %></span><% elsif @session.execution_claimed_at %><span class="badge bg-warning text-dark"><%= t(".execution_claimed") %></span><div class="small text-medium-emphasis"><%= opencode_time(@session.execution_claimed_at) %></div><div class="small text-medium-emphasis"><%= t(".resume_attempts", count: @session.resume_attempts) %></div><% elsif @session.time_compacting_at %><span class="badge bg-info"><%= t(".compacting") %></span><% else %><span class="badge bg-success"><%= t(".active") %></span><% end %></div>
      <div class="col-md-4"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".time_created") %></div><%= opencode_time(@session.time_created_at) %></div>
      <div class="col-md-4"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".time_updated") %></div><%= opencode_time(@session.time_updated_at) %></div>
      <div class="col-md-4"><div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".workspace") %></div><% if @session.workspace %><%= @session.workspace.provider %><div class="small"><code><%= @session.workspace.id %></code></div><% else %><code><%= @session.workspace_id.presence || "-" %></code><% end %></div>
      <% if @session.parent_id.present? || @session.fork_session_id.present? %>
        <div class="col-12"><div class="alert alert-light border mb-0"><% if @session.parent_id.present? %><div><%= t(".parent_session") %>: <code><%= @session.parent_id %></code></div><% end %><% if @session.fork_session_id.present? %><div><%= t(".forked_from") %>: <code><%= @session.fork_session_id %></code> · <%= t(".fork_boundary") %>: <%= t(".fork_boundaries.#{@session.fork_boundary_type}", message: @session.fork_boundary_message_id, default: [@session.fork_boundary_type, @session.fork_boundary_message_id].compact.join(" ").presence || "-") %></div><% end %></div></div>
      <% end %>
      <% if @session.metadata_data.present? || @session.summary_diffs_data.present? %>
        <div class="col-12"><details><summary class="fw-semibold"><%= t(".metadata_and_diffs") %></summary><pre class="bg-light rounded p-3 mt-2 mb-0 small"><code><%= pretty_json({metadata: @session.metadata_data, summary_diffs: @session.summary_diffs_data}) %></code></pre></details></div>
      <% end %>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header d-flex align-items-center flex-wrap gap-2">
    <%= svg_icon("free.svg#cil-history", "icon") %>
    <strong><%= t(".message_timeline") %></strong>
    <span class="badge bg-primary"><%= @messages.size %> <%= t(".messages") %></span>
    <span class="badge bg-dark"><%= t(".durable_events") %> <%= @event_count %></span>
    <span class="badge bg-light text-dark border"><%= @message_storage == :session_message ? "session_message" : "message / part" %></span>
    <% if @event_count > @events.size %><small class="text-medium-emphasis"><%= t(".latest_events", count: @events.size) %></small><% end %>
  </div>
  <div class="card-body">
    <% if @timeline.empty? %>
      <div class="text-center text-medium-emphasis py-4"><%= t(".no_messages") %></div>
    <% else %>
      <% message_partial = @message_storage == :session_message ? "sessions/session_message" : "sessions/legacy_message" %>
      <% @timeline.each do |(_time, kind, record, collapsed_count)| %>
        <% if kind.zero? %>
          <%= render partial: message_partial, locals: {message: record} %>
        <% else %>
          <%= render "sessions/event_marker", event: record, collapsed_count: collapsed_count %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @inbox_items.any? %>
  <div class="card mb-4">
    <div class="card-header"><strong><%= t(".session_inbox") %></strong><span class="badge bg-warning text-dark ms-2"><%= @inbox_items.size %></span></div>
    <div class="card-body">
      <% @inbox_items.each do |item| %>
        <details class="mb-2"><summary><span class="badge bg-warning text-dark"><%= item.inbox_type %></span> <code><%= item.id %></code> · #<%= item.enqueued_seq %> · <%= item.delivery %> · <%= opencode_time(item.time_created_at) %></summary><pre class="bg-light rounded p-3 mt-2 small"><code><%= pretty_json(item.parsed_payload) %></code></pre></details>
      <% end %>
    </div>
  </div>
<% end %>

<% if @instruction_entries.any? || @session.instruction_state.present? %>
  <div class="card mb-4">
    <div class="card-header"><strong><%= t(".instruction_context") %></strong><span class="badge bg-info ms-2"><%= @instruction_entries.size %></span></div>
    <div class="card-body">
      <% if @session.instruction_state %><div class="small text-medium-emphasis mb-3"><%= t(".epoch") %> <%= @session.instruction_state.epoch_start %> · <%= t(".through_sequence") %> <%= @session.instruction_state.through_seq %></div><% end %>
      <% @instruction_entries.each do |entry| %><details class="mb-2"><summary><code><%= entry.key %></code> <% if entry.removed? %><span class="badge bg-secondary"><%= t(".removed") %></span><% end %></summary><pre class="bg-light rounded p-3 mt-2 small"><code><%= pretty_json(entry.value_data) %></code></pre></details><% end %>
    </div>
  </div>
<% end %>
