<div data-controller="inspector" data-action="keydown.esc@window->inspector#close keydown.tab->inspector#trap">
  <header class="oc-session-header oc-overview">
    <div class="oc-session-identity"><%= link_to @project.name.presence || @project.id, project_path(@project), class: "text-body-secondary" %><span>/</span><strong><%= @session.title.presence || @session.slug %></strong><%= session_state_badge(@session) %></div>
    <button class="btn btn-sm btn-outline-secondary" data-action="inspector#toggle" data-inspector-target="toggle" aria-expanded="false" aria-controls="session-inspector"><%= t("workspace.inspect") %></button>
    <details class="oc-session-menu"><summary aria-label="<%= t("workspace.session_actions") %>">•••</summary><div><%= button_to t("sessions.show.remove_session"), project_session_path(@project, @session), method: :delete, class: "btn btn-sm btn-outline-danger", onclick: "return confirm(this.dataset.confirm)", data: {confirm: t("sessions.show.remove_confirm")} %></div></details>
  </header>
  <div class="oc-session-layout" data-inspector-target="layout">
    <main class="oc-conversation">
<div class="card mb-4 oc-timeline" data-controller="timeline">
  <div class="card-header d-flex align-items-center flex-wrap gap-2">
    <%= svg_icon("free.svg#cil-history", "icon") %>
    <strong><%= t(".message_timeline") %></strong>
    <span class="badge bg-primary"><%= @messages.size %> <%= t(".messages") %></span>
    <span class="badge bg-dark"><%= t(".durable_events") %> <%= @event_count %></span>
    <span class="badge bg-body-tertiary text-body border"><%= @message_storage_label %></span>
    <% if @event_count > @events.size %><small class="text-body-secondary"><%= t(".latest_events", count: @events.size) %></small><% end %>
  </div>
  <div class="oc-timeline-toolbar">
    <div class="chip-set" role="group" aria-label="<%= t("viewer.filter_timeline") %>" data-timeline-target="filters" data-action="select.coreui.chip-set->timeline#filter">
      <% %w[conversation tools subagents browser events all].each do |category| %>
        <button type="button" class="chip chip-primary <%= "active" if category == "conversation" %>" data-timeline-target="filter" data-coreui-chip-value="<%= category %>" data-category="<%= category %>" aria-pressed="<%= category == "conversation" %>"><%= t("viewer.categories.#{category}") %></button>
      <% end %>
    </div>
    <div class="d-flex align-items-center gap-2 mt-2">
      <input type="search" class="form-control form-control-sm" aria-label="<%= t("viewer.search_timeline") %>" placeholder="<%= t("viewer.search_timeline") %>" data-timeline-target="search" data-action="input->timeline#apply">
      <span class="small text-body-secondary text-nowrap" role="status"><span data-timeline-target="count"><%= @timeline.size %></span> <%= t("viewer.visible") %></span>
      <button type="button" class="btn btn-sm btn-link text-nowrap" data-action="timeline#reset"><%= t("viewer.reset_filters") %></button>
    </div>
  </div>
  <div class="card-body">
    <div class="text-center text-body-secondary py-4" data-timeline-target="empty" hidden><%= t("viewer.no_activity") %></div>
    <% if @timeline.empty? %>
      <div class="text-center text-body-secondary py-4"><%= t(".no_messages") %></div>
    <% else %>
      <% message_partial = @message_storage == :session_message ? "sessions/session_message" : "sessions/legacy_message" %>
      <% @timeline.each do |(_time, kind, record, collapsed_count)| %>
        <div id="message-<%= record.id %>" data-timeline-target="entry" data-categories="<%= timeline_categories(record, kind) %>">
        <% if kind.zero? %>
          <%= render partial: message_partial, locals: {message: record} %>
        <% else %>
          <%= render "sessions/event_marker", event: record, collapsed_count: collapsed_count %>
        <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<% if @inbox_items.any? %>
  <section class="oc-queue">
    <h2 class="fs-6"><%= t("sessions.show.session_inbox") %> <span class="text-body-secondary"><%= @inbox_items.size %></span></h2>
    <% @inbox_items.each do |item| %>
      <article class="oc-queue-item">
        <span class="badge bg-body-tertiary text-body border"><%= item.delivery %> · <%= item.inbox_type %></span>
        <p class="oc-plain mt-2"><%= item.parsed_payload["text"] %></p>
        <% Array(item.parsed_payload["files"]).each_with_index do |file, index| %><%= render "sessions/attachment", file: file, message: item, selector: {file: index} %><% end %>
        <details><summary class="small text-body-secondary"><code><%= item.id %></code> · #<%= item.enqueued_seq %> · <%= opencode_time(item.time_created_at) %></summary><pre class="oc-pre"><%= pretty_json(item.parsed_payload) %></pre></details>
      </article>
    <% end %>
  </section>
<% end %>

    </main>
    <button class="oc-inspector-backdrop" data-inspector-target="backdrop" data-action="inspector#close" aria-label="<%= t("workspace.close_inspector") %>" hidden></button>
    <aside id="session-inspector" class="oc-inspector" data-inspector-target="panel" aria-label="<%= t("workspace.inspect") %>" tabindex="-1" hidden>
      <div class="d-flex justify-content-between align-items-center mb-3"><strong><%= t("workspace.inspect") %></strong><button class="btn-close" data-action="inspector#close" aria-label="<%= t("workspace.close_inspector") %>"></button></div>
      <nav class="oc-inspector-tabs" aria-label="<%= t("workspace.inspect") %>">
        <% %w[details jobs schedules].each_with_index do |tab, index| %>
          <button class="btn btn-sm <%= "active" if index.zero? %>" data-inspector-target="tab" data-action="inspector#select" data-panel="<%= tab %>" aria-pressed="<%= index.zero? %>" aria-controls="inspector-<%= tab %>"><%= t("workspace.#{tab}") %></button>
        <% end %>
      </nav>
      <section id="inspector-details" data-inspector-target="section"><%= render "sessions/details" %><%= render "sessions/instructions" %>
        <details class="mt-3"><summary><%= t("workspace.storage") %></summary>
          <p class="small text-body-secondary mt-2"><%= @message_storage_label %></p>
          <% @session_messages.each do |message| %>
            <% if message.session_parts.any? %><details><summary><code><%= message.id %></code> · <%= message.session_parts.size %> <%= t("workspace.parts") %></summary><% message.session_parts.each do |part| %><pre class="oc-pre"><%= pretty_json(part.attributes.except("data").merge("data" => part.parsed_data)) %></pre><% end %></details><% end %>
          <% end %>
          <% @blob_refs.each do |ref| %><details><summary><code><%= ref.content_hash %></code> · #<%= ref.seq %></summary><pre class="oc-pre"><%= pretty_json(ref.attributes.merge("blob" => @blobs[ref.content_hash]&.attributes)) %></pre></details><% end %>
        </details>
      </section>
      <section id="inspector-jobs" data-inspector-target="section" hidden><%= render partial: "background_jobs/job", collection: @jobs %><% if @jobs.empty? %><p class="text-body-secondary"><%= t("workspace.no_jobs") %></p><% end %></section>
      <section id="inspector-schedules" data-inspector-target="section" hidden><%= render partial: "schedules/schedule", collection: @schedules %><% if @schedules.empty? %><p class="text-body-secondary"><%= t("workspace.no_schedules") %></p><% end %></section>
    </aside>
  </div>
</div>
