<div class="card mb-4">
  <div class="card-header bg-primary text-white d-flex align-items-center">
    <%= svg_icon("free.svg#cil-folder-open", "icon me-2") %>
    <strong><%= @project.name.presence || @project.id %></strong>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-lg-8">
        <div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".worktree") %></div>
        <code class="text-break"><%= @project.worktree %></code>
      </div>
      <div class="col-lg-4">
        <div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".project_id") %></div>
        <code class="text-break"><%= @project.id %></code>
      </div>
      <div class="col-md-3">
        <div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".vcs") %></div>
        <%= @project.vcs.presence || "-" %>
      </div>
      <div class="col-md-3">
        <div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".time_created") %></div>
        <%= opencode_time(@project.time_created_at) %>
      </div>
      <div class="col-md-3">
        <div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".time_updated") %></div>
        <%= opencode_time(@project.time_updated_at) %>
      </div>
      <div class="col-md-3">
        <div class="text-medium-emphasis small text-uppercase fw-semibold"><%= t(".time_initialized") %></div>
        <%= opencode_time(@project.time_initialized_at) %>
      </div>
      <% if @project.commands_data.present? || @project.sandboxes_data.present? %>
        <div class="col-12">
          <details>
            <summary class="fw-semibold"><%= t(".configuration") %></summary>
            <pre class="bg-light rounded p-3 mt-2 mb-0 small"><code><%= pretty_json({commands: @project.commands_data, sandboxes: @project.sandboxes_data}) %></code></pre>
          </details>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3"><div class="card text-white bg-primary"><div class="card-body"><div class="fs-4 fw-semibold"><%= @total_sessions %></div><div><%= t(".total_sessions") %></div></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="card text-white bg-success"><div class="card-body"><div class="fs-4 fw-semibold"><%= number_with_delimiter(@total_tokens) %></div><div><%= t(".total_tokens") %></div></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="card text-white bg-info"><div class="card-body"><div class="fs-4 fw-semibold"><%= number_to_currency(@total_cost, precision: 6) %></div><div><%= t(".total_cost") %></div></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="card bg-light"><div class="card-body"><div class="fs-4 fw-semibold"><span class="text-success">+<%= @total_additions %></span> <span class="text-danger">-<%= @total_deletions %></span></div><div><%= t(".code_changes") %></div></div></div></div>
</div>

<% if @project_directories.any? || @workspaces.any? || @permissions.any? %>
  <div class="card mb-4">
    <div class="card-header"><strong><%= t(".project_storage") %></strong></div>
    <div class="card-body">
      <% if @project_directories.any? %>
        <h6><%= t(".directories") %></h6>
        <div class="table-responsive mb-3"><table class="table table-sm mb-0"><thead><tr><th><%= t(".directory") %></th><th><%= t(".type") %></th><th><%= t(".strategy") %></th><th><%= t(".time_created") %></th></tr></thead><tbody>
          <% @project_directories.each do |entry| %><tr><td><code><%= entry.directory %></code></td><td><%= entry.directory_type.presence || "-" %></td><td><%= entry.strategy.presence || "-" %></td><td><%= opencode_time(entry.time_created_at) %></td></tr><% end %>
        </tbody></table></div>
      <% end %>
      <% if @workspaces.any? %>
        <h6><%= t(".workspaces") %></h6>
        <div class="table-responsive mb-3"><table class="table table-sm mb-0"><thead><tr><th><%= t(".name") %></th><th><%= t(".type") %></th><th><%= t(".branch") %></th><th><%= t(".directory") %></th><th><%= t(".last_used") %></th></tr></thead><tbody>
          <% @workspaces.each do |workspace| %><tr><td><%= workspace.name.presence || workspace.id %></td><td><%= workspace.workspace_type %></td><td><%= workspace.branch.presence || "-" %></td><td><code><%= workspace.directory.presence || "-" %></code></td><td><%= opencode_time(workspace.time_used_at) %></td></tr><% end %>
        </tbody></table></div>
      <% end %>
      <% if @permissions.any? %>
        <h6><%= t(".saved_permissions") %></h6>
        <div class="d-flex flex-wrap gap-2"><% @permissions.each do |permission| %><span class="badge bg-light text-dark border"><%= permission.action %> · <%= permission.resource %></span><% end %></div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-header d-flex align-items-center">
    <%= svg_icon("free.svg#cil-chat-bubble", "icon me-2") %>
    <strong><%= t(".sessions") %></strong>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-light"><tr><th><%= t(".session_title") %></th><th><%= t(".agent_model") %></th><th class="text-end"><%= t(".usage") %></th><th class="text-center"><%= t(".messages") %></th><th><%= t(".state") %></th><th><%= t(".session_time_updated") %></th></tr></thead>
        <tbody>
          <% if @sessions.load.any? %>
            <% @sessions.each do |session| %>
              <% new_message_count = @session_message_counts.fetch(session.id, 0) %>
              <tr>
                <td><div class="fw-semibold"><%= link_to(session.title.presence || session.slug, project_session_path(@project, session), class: "text-decoration-none") %></div><code class="small text-medium-emphasis"><%= session.id %></code></td>
                <td><div><%= session.agent.presence || "-" %></div><small class="text-medium-emphasis"><%= [session.model_data["providerID"], session.model_data["id"]].compact.join("/").presence || "-" %></small></td>
                <td class="text-end"><div><%= number_with_delimiter(session.total_tokens) %> <small><%= t(".tokens") %></small></div><small class="text-medium-emphasis"><%= number_to_currency(session.cost.to_f, precision: 6) %></small></td>
                <td class="text-center"><%= new_message_count.positive? ? new_message_count : @legacy_message_counts.fetch(session.id, 0) %><div class="small text-medium-emphasis"><%= new_message_count.positive? ? "session_message" : "message/part" %></div></td>
                <td>
                  <% if session.time_archived_at %><span class="badge bg-secondary"><%= t(".archived") %></span><% end %>
                  <% if session.time_suspended_at %><span class="badge bg-warning text-dark"><%= t(".suspended") %></span><% end %>
                  <% unless session.time_archived_at || session.time_suspended_at %><span class="badge bg-success"><%= t(".active") %></span><% end %>
                  <% if session.fork_session_id.present? %><div class="small text-medium-emphasis"><%= t(".fork") %> #<%= session.fork_seq || "-" %></div><% end %>
                </td>
                <td><%= opencode_time(session.time_updated_at) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="6" class="text-center text-medium-emphasis py-4"><%= t(".no_sessions") %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if @pagy.pages > 1 %><div class="card-footer"><%== pagy_bootstrap_nav(@pagy) %></div><% end %>
</div>
